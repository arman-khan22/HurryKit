    "sitemap": "tsx scripts/generate-sitemap.ts",
    "validate-registry": "tsx scripts/validate-registry.ts",
    "postinstall": "tsx scripts/validate-registry.ts || true"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "0.12.15",
    "@ffmpeg/util": "0.12.2",
    "@jsquash/avif": "^2.1.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "heic2any": "^0.0.4",
    "jszip": "^3.10.1",
    "marked": "^15.0.0",
    "minisearch": "^7.1.0",
    "next": "^15.1.0",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "utif": "^3.1.0",
    "zod": "^3.24.0",
    "zustand": "^5.0.0"
