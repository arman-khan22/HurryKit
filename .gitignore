# ==============================================================================
# Hurrykit Production-Grade .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Dependencies & Package Managers
# ------------------------------------------------------------------------------
node_modules/
.pnp
.pnp.js
.pnp.*
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

# ------------------------------------------------------------------------------
# 2. Environment Variables & Secrets (CRITICAL SECURITY)
# ------------------------------------------------------------------------------
.env
.env*.local
.env.production
.env.staging
.env.development
.env.test

# Never commit keys, certs, or credentials
*.pem
*.key
*.crt
*.pfx
*.p12
*service-account*.json
credentials.json

# Whitelist safe configuration examples
!.env.example
!.env.template

# ------------------------------------------------------------------------------
# 3. Build Outputs, Compilers & Caches
# ------------------------------------------------------------------------------
.next/
out/
build/
dist/
.swc/
.turbo/
.cache/
*.tsbuildinfo
tsconfig.tsbuildinfo

# ------------------------------------------------------------------------------
# 4. Testing, Coverage & Reports
# ------------------------------------------------------------------------------
coverage/
.nyc_output/
*.lcov
test-results/
playwright-report/
blob-report/
cypress/videos/
cypress/screenshots/

# ------------------------------------------------------------------------------
# 5. Logs & Runtime Diagnostics
# ------------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/

# ------------------------------------------------------------------------------
# 6. Operating System Metadata
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory

# ------------------------------------------------------------------------------
# 7. IDE & Editor Workspace State
# ------------------------------------------------------------------------------
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
.project
.settings/

# VS Code (ignore user state, preserve team settings/recommendations)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# ------------------------------------------------------------------------------
# 8. Antigravity & AI Agent Tooling (Excluded for clean public repo)
# ------------------------------------------------------------------------------
.agents/
.gemini/
.gsd/
adapters/
docs/gsd/
skills-lock.json
model_capabilities.yaml
GSD-STYLE.md
PROJECT_RULES.md

# Agent validation helper scripts
scripts/validate-agents.*
scripts/validate-skills.*
scripts/validate-templates.*
scripts/validate-workflows.*
scripts/validate-all.*
scripts/validate-encoding.*
scripts/search_repo.*
scripts/setup_search.*

# ------------------------------------------------------------------------------
# 9. Miscellaneous & Binary Specs
# ------------------------------------------------------------------------------
docs/specs/*.docx
.vercel
tmp/
temp/
*.sqlite
*.sqlite3
*.sqlite-journal
*.db
