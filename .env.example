# Hurrykit Environment Configuration
# Copy this file to .env.local and adjust values as needed.

# Canonical site URL (server-side context, no trailing slash)
SITE_URL=https://hurrykit.com

# Public canonical site URL accessible in browser client bundles
NEXT_PUBLIC_SITE_URL=https://hurrykit.com

# Privacy-friendly analytics identifier (Optional, e.g. Plausible domain or Cloudflare Web Analytics token)
ANALYTICS_ID=
NEXT_PUBLIC_ANALYTICS_ID=

# Deployment environment (development | preview | production)
NEXT_PUBLIC_ENV=development

# FFmpeg WebAssembly engine base CDN URL (Cloudflare R2 or CDN mirror)
NEXT_PUBLIC_FFMPEG_BASE_URL=https://cdn.hurrykit.com/ffmpeg

# FFmpeg version folder name in storage (must match the assets in storage)
NEXT_PUBLIC_FFMPEG_VERSION=0.12.10
